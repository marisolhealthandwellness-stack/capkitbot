BILLING_ENABLED=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
KIT_API_KEY=
# Used to build Stripe success/cancel/return URLs when the request Origin is
# unavailable (e.g. the webhook). Set to your site's full URL, no trailing slash.
NEXT_PUBLIC_SITE_URL=
